<% month_param = @current_month.strftime("%Y-%m") %>

<div class="space-y-4 pb-6 lg:pb-12 flex flex-col">
  <header class="flex justify-between items-center text-primary font-medium">
    <h1 class="text-xl"><%= t("recurring_transactions.title") %></h1>
    <div class="flex items-center gap-2">
      <%= render DS::Menu.new do |menu| %>
        <% unless @family.recurring_transactions_disabled? %>
          <% menu.with_item(
              variant: "button",
              text: t("recurring_transactions.identify_patterns"),
              href: identify_recurring_transactions_path(view: @view, month: month_param),
              method: :post,
              icon: "search") %>
        <% end %>
        <% menu.with_item(
            variant: "button",
            text: t("recurring_transactions.cleanup_stale"),
            href: cleanup_recurring_transactions_path(view: @view, month: month_param),
            method: :post,
            icon: "trash-2") %>
        <% menu.with_item(
            variant: "button",
            text: @family.recurring_transactions_disabled? ? t("recurring_transactions.settings.enable_detection") : t("recurring_transactions.settings.disable_detection"),
            href: update_settings_recurring_transactions_path(
              recurring_transactions_disabled: @family.recurring_transactions_disabled? ? "false" : "true",
              view: @view,
              month: month_param
            ),
            method: :patch,
            icon: @family.recurring_transactions_disabled? ? "toggle-left" : "toggle-right") %>
      <% end %>

      <%= render DS::Link.new(
          text: t("recurring_transactions.new"),
          icon: "plus",
          variant: "primary",
          href: new_recurring_transaction_path(view: @view, month: month_param),
          frame: :modal,
          class: "hidden md:inline-flex"
        ) %>

      <%= render DS::Link.new(
          icon: "plus",
          variant: "icon-inverse",
          href: new_recurring_transaction_path(view: @view, month: month_param),
          frame: :modal,
          class: "rounded-full md:hidden"
        ) %>
    </div>
  </header>

  <div class="flex items-center justify-between gap-4 flex-wrap">
    <div class="flex items-center gap-1">
      <%= link_to recurring_transactions_path(view: @view, month: (@current_month - 1.month).strftime("%Y-%m")),
          class: "flex items-center justify-center w-8 h-8 rounded-lg text-secondary hover:text-primary hover:bg-surface-hover",
          "aria-label": t("recurring_transactions.previous_month") do %>
        <%= icon "chevron-left", size: "sm" %>
      <% end %>

      <p class="text-sm font-medium text-primary w-36 text-center capitalize">
        <%= l(@current_month, format: t("recurring_transactions.month_format")) %>
      </p>

      <%= link_to recurring_transactions_path(view: @view, month: (@current_month + 1.month).strftime("%Y-%m")),
          class: "flex items-center justify-center w-8 h-8 rounded-lg text-secondary hover:text-primary hover:bg-surface-hover",
          "aria-label": t("recurring_transactions.next_month") do %>
        <%= icon "chevron-right", size: "sm" %>
      <% end %>

      <% unless @current_month == Date.current.beginning_of_month %>
        <%= link_to t("recurring_transactions.today"),
            recurring_transactions_path(view: @view),
            class: "text-xs font-medium text-link hover:underline ml-2" %>
      <% end %>
    </div>

    <div class="flex items-center gap-4">
      <% if @schedule.occurrences.any? %>
        <div class="hidden md:flex items-center gap-2 text-xs text-secondary">
          <%= render DS::Pill.new(
              label: t("recurring_transactions.summary.executed", count: @schedule.executed_count),
              tone: :success, marker: false) %>
          <%= render DS::Pill.new(
              label: t("recurring_transactions.summary.pending", count: @schedule.pending_count),
              tone: :neutral, marker: false) %>
        </div>
      <% end %>

      <%= render DS::SegmentedControl.new(aria_label: t("recurring_transactions.view_switcher")) do |sc| %>
        <% sc.with_segment(
            safe_join([ icon("list"), tag.span(t("recurring_transactions.list_view"), class: "truncate") ]),
            active: @view == "list",
            href: recurring_transactions_path(view: "list", month: month_param),
            class: "min-w-0 gap-2") %>
        <% sc.with_segment(
            safe_join([ icon("calendar"), tag.span(t("recurring_transactions.calendar_view"), class: "truncate") ]),
            active: @view == "calendar",
            href: recurring_transactions_path(view: "calendar", month: month_param),
            class: "min-w-0 gap-2") %>
      <% end %>
    </div>
  </div>

  <% if @recurring_transactions.empty? %>
    <div class="bg-container rounded-xl shadow-border-xs p-4">
      <%= render DS::EmptyState.new(
        icon: "repeat",
        title: t("recurring_transactions.empty.title"),
        description: t("recurring_transactions.empty.description")
      ) do |empty| %>
        <% empty.with_action do %>
          <div class="flex items-center gap-2">
            <%= render DS::Link.new(
              text: t("recurring_transactions.new"),
              icon: "plus",
              variant: "primary",
              href: new_recurring_transaction_path,
              frame: :modal
            ) %>
            <% unless @family.recurring_transactions_disabled? %>
              <%= render DS::Link.new(
                text: t("recurring_transactions.identify_patterns"),
                icon: "search",
                variant: "outline",
                href: identify_recurring_transactions_path,
                method: :post
              ) %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <% if @view == "calendar" %>
      <%= render "recurring_transactions/calendar", schedule: @schedule, current_month: @current_month, view: @view, month_param: month_param %>
    <% else %>
      <%= render "recurring_transactions/list", schedule: @schedule, view: @view, month_param: month_param %>
    <% end %>

    <% if @view == "list" && @inactive_recurring_transactions.any? %>
      <div class="bg-container-inset rounded-xl p-1 w-full">
        <div class="py-2 px-4 font-medium text-xs text-secondary uppercase space-x-1.5">
          <%= tag.span t("recurring_transactions.inactive_section") %>
          <span>·</span>
          <%= tag.span @inactive_recurring_transactions.size %>
        </div>
        <div class="bg-container shadow-border-xs rounded-lg">
          <% @inactive_recurring_transactions.each do |recurring_transaction| %>
            <%= render "recurring_transactions/inactive_row", recurring_transaction: recurring_transaction, view: @view, month_param: month_param %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
