<%# locals: (schedule:, view:, month_param:) %>

<div class="space-y-2">
  <% if schedule.occurrences.empty? %>
    <div class="bg-container rounded-xl shadow-border-xs p-4">
      <%= render DS::EmptyState.new(
        icon: "calendar",
        title: t("recurring_transactions.no_occurrences.title"),
        description: t("recurring_transactions.no_occurrences.description")
      ) %>
    </div>
  <% else %>
    <% schedule.occurrences_by_date.each do |date, occurrences| %>
      <div class="bg-container-inset rounded-xl p-1 w-full">
        <div class="py-2 px-4 flex items-center justify-between font-medium text-xs text-secondary">
          <p class="uppercase space-x-1.5">
            <%= tag.span l(date, format: :long) %>
            <span>·</span>
            <%= tag.span occurrences.size %>
          </p>
        </div>
        <div class="bg-container shadow-border-xs rounded-lg">
          <% occurrences.each do |occurrence| %>
            <%= render "recurring_transactions/occurrence", occurrence: occurrence, view: view, month_param: month_param %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
